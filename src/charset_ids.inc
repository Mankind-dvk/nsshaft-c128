; 字形编号表 / Mixed multicolor/hires glyph allocation
; ---------------------------------------------------------------------------
; GLYPH_* 是字形索引；CHAR_* 是屏幕码。本项目分配前 68 槽，不启用 ECM。
; 第一源库只放图形，第二源库提供文字，VIC 始终读取 $2800 的合成结果。
; EN: Two immutable inputs -> one live output; Color RAM selects hires/multicolor.
; Game slots: 0 blank; 1..7 bodies; 8..19 fragments; 20..39 UI/ceiling;
;             40..55 imported HUD text; 56..61 fade variants; 62..65 SCORE letters.
;             66..67 independent conveyor LOWER fragments.
CHARSET_ADDRESS = $2800
CHARSET_GLYPH_COUNT = 68
CHARSET_GLYPH_BYTES = 8
SOURCE_CHARSET_GLYPH_COUNT = 256
SOURCE_CHARSET_BYTES = SOURCE_CHARSET_GLYPH_COUNT * CHARSET_GLYPH_BYTES
GRAPHICS_CHARSET_ADDRESS = $4000
TEXT_CHARSET_ADDRESS = $4800
GRAPHICS_GLYPH_COUNT = 40
MULTICOLOR_CELL = $08
FADE_STAGE_CRACKED = 0
FADE_STAGE_BROKEN = 1

GLYPH_BLANK = 0
GLYPH_PLATFORM_FULL = 1
GLYPH_SPIKE_FULL = 2
GLYPH_SPRING_FULL = 3
GLYPH_SPRING_COMPRESSED_FULL = 4
GLYPH_CONVEYOR_LEFT_FULL = 5
GLYPH_CONVEYOR_RIGHT_FULL = 6
GLYPH_FADE_CRACKED_FULL = 7

GLYPH_NORMAL_UPPER = 8
GLYPH_NORMAL_LOWER = 9
GLYPH_SPIKE_UPPER = 10
GLYPH_SPIKE_LOWER = 11
GLYPH_SPRING_UPPER = 12
GLYPH_SPRING_LOWER = 13
GLYPH_SPRING_COMPRESSED_UPPER = 14
GLYPH_SPRING_COMPRESSED_LOWER = 15
GLYPH_FADE_CRACKED_UPPER = 16
GLYPH_FADE_CRACKED_LOWER = 17
GLYPH_CONVEYOR_LEFT_UPPER = 18
GLYPH_CONVEYOR_RIGHT_UPPER = 19

GLYPH_UI_FRAME = 20
GLYPH_CEILING_SPIKE = 21
GLYPH_DIAL_TOP_FIRST = 22          ; six nonblank top-row tiles
GLYPH_DIAL_MIDDLE_FIRST = 28       ; four nonblank middle-row tiles
GLYPH_DIAL_BOTTOM_FIRST = 32       ; eight bottom-row tiles

; 游戏仅抽取 HUD 真正使用的 20 个文字字形；菜单使用独立 TEXT_* 编号。
; EN: Import ten digits, H/O/P/T/X/colon and S/C/R/E, not the entire alphabet.
GLYPH_DIGIT_0 = 40                 ; 40..49 = digits 0..9
GLYPH_H = 50
GLYPH_O = 51
GLYPH_P = 52
GLYPH_T = 53
GLYPH_X = 54
GLYPH_COLON = 55
; 材质扩展区：完整与末级虚化砖纹；第二级放在 7/16/17。
; EN: Intact and broken fade tiles; cracked tiles use slots 7/16/17.
GLYPH_FADE_FULL = 56
GLYPH_FADE_UPPER = 57
GLYPH_FADE_LOWER = 58
GLYPH_FADE_BROKEN_FULL = 59
GLYPH_FADE_BROKEN_UPPER = 60
GLYPH_FADE_BROKEN_LOWER = 61
GLYPH_S = 62
GLYPH_C = 63
GLYPH_R = 64
GLYPH_E = 65
GLYPH_CONVEYOR_LEFT_LOWER = 66
GLYPH_CONVEYOR_RIGHT_LOWER = 67

CHAR_BLANK = GLYPH_BLANK
CHAR_PLATFORM_FULL = GLYPH_PLATFORM_FULL
CHAR_SPIKE_TRIANGLE = GLYPH_SPIKE_FULL
CHAR_SPRING_FULL = GLYPH_SPRING_FULL
CHAR_SPRING_COMPRESSED_FULL = GLYPH_SPRING_COMPRESSED_FULL
CHAR_CONVEYOR_LEFT_FULL = GLYPH_CONVEYOR_LEFT_FULL
CHAR_CONVEYOR_RIGHT_FULL = GLYPH_CONVEYOR_RIGHT_FULL
CHAR_FADE_FULL = GLYPH_FADE_FULL

CHAR_NORMAL_UPPER = GLYPH_NORMAL_UPPER
CHAR_NORMAL_LOWER = GLYPH_NORMAL_LOWER
CHAR_SPIKE_UPPER = GLYPH_SPIKE_UPPER
CHAR_SPIKE_LOWER = GLYPH_SPIKE_LOWER
CHAR_SPRING_UPPER = GLYPH_SPRING_UPPER
CHAR_SPRING_LOWER = GLYPH_SPRING_LOWER
CHAR_SPRING_COMPRESSED_UPPER = GLYPH_SPRING_COMPRESSED_UPPER
CHAR_SPRING_COMPRESSED_LOWER = GLYPH_SPRING_COMPRESSED_LOWER
CHAR_CONVEYOR_LEFT_UPPER = GLYPH_CONVEYOR_LEFT_UPPER
CHAR_CONVEYOR_RIGHT_UPPER = GLYPH_CONVEYOR_RIGHT_UPPER
CHAR_CONVEYOR_LEFT_LOWER = GLYPH_CONVEYOR_LEFT_LOWER
CHAR_CONVEYOR_RIGHT_LOWER = GLYPH_CONVEYOR_RIGHT_LOWER
CHAR_FADE_UPPER = GLYPH_FADE_UPPER
CHAR_FADE_LOWER = GLYPH_FADE_LOWER

; 已激活平台的 FULL/UPPER/LOWER 不再相邻，必须逐个匹配，不能用范围判断。
; EN: Active fade IDs are noncontiguous: never classify them by an interval.
CHAR_FADE_BROKEN_FULL = GLYPH_FADE_BROKEN_FULL
CHAR_FADE_BROKEN_UPPER = GLYPH_FADE_BROKEN_UPPER
CHAR_FADE_BROKEN_LOWER = GLYPH_FADE_BROKEN_LOWER
CHAR_FADE_CRACKED_FULL = GLYPH_FADE_CRACKED_FULL
CHAR_FADE_CRACKED_UPPER = GLYPH_FADE_CRACKED_UPPER
CHAR_FADE_CRACKED_LOWER = GLYPH_FADE_CRACKED_LOWER

CHAR_DIGIT_0 = GLYPH_DIGIT_0
CHAR_H = GLYPH_H
CHAR_O = GLYPH_O
CHAR_P = GLYPH_P
CHAR_T = GLYPH_T
CHAR_X = GLYPH_X
CHAR_COLON = GLYPH_COLON
CHAR_S = GLYPH_S
CHAR_C = GLYPH_C
CHAR_R = GLYPH_R
CHAR_E = GLYPH_E
; 01=共享白色，11=每格颜色：砖纹为红，尖刺为绿。
; EN: Shared white plus local red bricks or local green spikes.
CHAR_UI_FRAME = GLYPH_UI_FRAME
CHAR_CEILING_SPIKE = GLYPH_CEILING_SPIKE
CHAR_DIAL_ROW_1 = GLYPH_DIAL_TOP_FIRST
CHAR_DIAL_ROW_2 = GLYPH_DIAL_MIDDLE_FIRST
CHAR_DIAL_ROW_3 = GLYPH_DIAL_BOTTOM_FIRST

