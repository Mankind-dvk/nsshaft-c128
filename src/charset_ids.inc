spring_compressed_upper_glyph = CHARSET_ADDRESS + GLYPH_SPRING_COMPRESSED_UPPER*CHARSET_GLYPH_BYTES
spring_compressed_lower_glyph = CHARSET_ADDRESS + GLYPH_SPRING_COMPRESSED_LOWER*CHARSET_GLYPH_BYTES
fade_cracked_upper_glyph = CHARSET_ADDRESS + GLYPH_FADE_CRACKED_UPPER*CHARSET_GLYPH_BYTES
fade_cracked_lower_glyph = CHARSET_ADDRESS + GLYPH_FADE_CRACKED_LOWER*CHARSET_GLYPH_BYTES
conveyor_left_upper_glyph = CHARSET_ADDRESS + GLYPH_CONVEYOR_LEFT_UPPER*CHARSET_GLYPH_BYTES
conveyor_right_upper_glyph = CHARSET_ADDRESS + GLYPH_CONVEYOR_RIGHT_UPPER*CHARSET_GLYPH_BYTES
digit_font = CHARSET_ADDRESS + GLYPH_DIGIT_0*CHARSET_GLYPH_BYTES
brick_source_glyph = GRAPHICS_CHARSET_ADDRESS + GLYPH_PLATFORM_FULL*CHARSET_GLYPH_BYTES
fade_source_glyph = GRAPHICS_CHARSET_ADDRESS + GLYPH_FADE_FULL*CHARSET_GLYPH_BYTES
fade_cracked_source_glyph = GRAPHICS_CHARSET_ADDRESS + GLYPH_FADE_CRACKED_FULL*CHARSET_GLYPH_BYTES
fade_broken_source_glyph = GRAPHICS_CHARSET_ADDRESS + GLYPH_FADE_BROKEN_FULL*CHARSET_GLYPH_BYTES
spike_source_glyph = GRAPHICS_CHARSET_ADDRESS + GLYPH_SPIKE_FULL*CHARSET_GLYPH_BYTES
spring_source_glyph = GRAPHICS_CHARSET_ADDRESS + GLYPH_SPRING_FULL*CHARSET_GLYPH_BYTES
spring_compressed_source_glyph = GRAPHICS_CHARSET_ADDRESS + GLYPH_SPRING_COMPRESSED_FULL*CHARSET_GLYPH_BYTES
